# Frontend environment template. Copy to `.env.local` and adjust.
# Real values are never committed; this file is structure only.

# Base URL of the FastAPI ai-service, resolved server-side by the
# /api/v1/:path* rewrite in next.config.js. The browser never calls this
# address directly.
#
#   Local dev:            http://localhost:8000
#   Docker Compose:       http://ai-service:8000
AI_SERVICE_URL=http://localhost:8000

# Base URL of the NestJS platform backend, once it owns any of the public
# routes. The scaffold currently only serves GET /health.
# BACKEND_URL=http://localhost:4000

# Note: REDIS_URL is deliberately absent. Redis does not exist in
# docker-compose.yml yet, so declaring it would imply wiring that is not there.
