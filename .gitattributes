# Normalize line endings: LF in the repository, whatever the OS prefers on
# checkout. Without this, a Windows checkout reintroduces CRLF on every commit
# and Prettier's Delete-CR rule fails on files nobody actually edited.
* text=auto eol=lf

# Binary - never touch these.
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.gif binary
*.ico binary
*.pdf binary
*.pt  binary
*.onnx binary
*.db  binary

# Shell scripts must keep LF even on Windows.
*.sh text eol=lf
