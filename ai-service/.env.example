# ai-service (FastAPI) environment template. Copy to `ai-service/.env`.

# Required. Minimum 32 characters. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=replace-with-at-least-32-characters

# PostgreSQL. Under Docker Compose the host is `postgres`; from a host-run
# uvicorn, localhost on port 5436.
DATABASE_URL=postgresql://postgres:postgres@localhost:5436/agronexus

# JWT algorithm for its own cookie-signed sessions (kept for the cookie path
# in role_guard even though the browser no longer uses it directly).
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
COOKIE_SECURE=false

# Browser origins allowed by CORS.
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Internal service token. Must be the SAME value as backend's
# INTERNAL_SERVICE_SECRET. Empty means every internal call fails closed (a
# safe default, but every AI feature stops working until it is set).
INTERNAL_SERVICE_SECRET=

# --- API keys (optional) ---
GEMINI_API_KEY=
OPENWEATHER_API_KEY=

# --- Model ---
MODEL_PATH=data/models/disease-detection/v1/best.pt
MODEL_VERSION=1.0.0

# --- Chapa (payments, not yet wired) ---
CHAPA_SECRET_KEY=
CHAPA_BASE_URL=https://api.chapa.co/v1
