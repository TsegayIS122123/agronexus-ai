# Copy to .env and fill in real values. Never commit the filled .env file.

# --- Required -------------------------------------------------------------
# Signs JWTs. Generate your own; do not reuse a value from another machine.
#   python -c "import secrets; print(secrets.token_hex(32))"
# Must be at least 32 characters or the service refuses to start.
SECRET_KEY=replace-with-at-least-32-random-characters
# Local Docker Postgres. Host port 5436 maps to container 5432.
DATABASE_URL=postgresql://postgres:postgres@localhost:5436/agronexus

# --- Auth behaviour --------------------------------------------------------
ALGORITHM=HS256
# Session length in minutes. 1440 = 24 hours.
ACCESS_TOKEN_EXPIRE_MINUTES=1440
# false for local http, true behind HTTPS in staging/production.
COOKIE_SECURE=false
# Comma-separated browser origins allowed by CORS.
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# --- API keys (optional) ---------------------------------------------------
# Google AI Studio. Without it the chat assistant falls back to the built-in
# keyword knowledge base.
GEMINI_API_KEY=
# OpenWeather. Without it the weather endpoints return
# "OpenWeather API key not configured".
OPENWEATHER_API_KEY=

# --- Model artifacts -------------------------------------------------------
# Directory holding versioned weight folders; the service appends
# MODEL_VERSION and best.pt.
MODEL_PATH=../data/models/disease-detection
# Label of the versioned weight folder to load, e.g. v1 -> .../v1/best.pt
MODEL_VERSION=v1

# --- Planned, not yet used -------------------------------------------------
# Declared so the service has one configuration surface. Leave empty until the
# corresponding provider is actually wired up (Phase 3 notifications,
# Phase 4 Chapa payments). Empty means "not configured", not an error.
CHAPA_PUBLIC_KEY=
CHAPA_SECRET_KEY=
CHAPA_WEBHOOK_SECRET=
EMAIL_API_KEY=
EMAIL_FROM=
SMS_API_KEY=
SMS_SENDER_ID=
