# Backend (NestJS) environment template. Copy to `backend/.env` locally.
# Values here are structure, not secrets.

# --- Database ---
DB_HOST=localhost
DB_PORT=5436
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=agronexus

# --- JWT ---
# Generate with: openssl rand -hex 32
# Must differ from INTERNAL_SERVICE_SECRET.
JWT_SECRET=replace-with-64-hex-characters
JWT_REFRESH_SECRET=replace-with-a-different-64-hex-string
JWT_ACCESS_TTL_MINUTES=14
JWT_REFRESH_TTL_DAYS=7

# --- URLs ---
FRONTEND_BASE_URL=http://localhost:3000
# Where backend reaches ai-service. Under Docker Compose this is
# http://ai-service:8000; from a host-run `nest start`, localhost.
AI_SERVICE_URL=http://localhost:8000

# --- Internal service token ---
# Signs the short-lived token backend presents to ai-service. Must differ from
# both JWT secrets and must be the same value as ai-service's
# INTERNAL_SERVICE_SECRET or every proxied call fails closed.
INTERNAL_SERVICE_SECRET=replace-with-a-third-64-hex-string

# --- Email / SMS delivery ---
# Empty means "log only" (development default). Set for real delivery.
RESEND_API_KEY=
RESEND_FROM_EMAIL=AgroNexus <noreply@agronexus.local>
TELNYX_API_KEY=
TELNYX_FROM_NUMBER=

# --- CORS ---
CORS_ORIGINS=http://localhost:3000

# --- Service ---
PORT=4000
NODE_ENV=development
