# Backend service configuration. Copy to backend/.env and fill in.
# backend/.env is gitignored; this file is the checked-in contract.

# --- Database ---
# Postgres is exposed on 5436 by docker-compose to avoid clashing with a local
# Postgres on 5432. Inside compose the service is reachable at postgres:5432.
DB_HOST=localhost
DB_PORT=5436
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=agronexus
DB_LOGGING=false

# --- Tokens ---
# Generate each with: openssl rand -hex 32
# They MUST differ: a shared key would let a stolen access token mint refreshes.
# Each must be at least 32 characters or the service refuses to boot.
JWT_SECRET=replace-me-with-64-hex-characters-of-randomness-0000000000000000
JWT_REFRESH_SECRET=replace-me-with-a-different-64-hex-random-string-111111111
JWT_REFRESH_TTL_DAYS=7

# --- Frontend ---
# Used to build the verification and password-reset links sent by email.
FRONTEND_BASE_URL=http://localhost:3000

# --- Service ---
PORT=4000
NODE_ENV=development
