# Backend service configuration. Copy to backend/.env and fill in.
# backend/.env is gitignored; this file is the checked-in contract.

# --- Database ---
# Postgres is exposed on 5436 by docker-compose to avoid clashing with a local
# Postgres on 5432. Inside compose the service is reachable at postgres:5432.
DB_HOST=localhost
DB_PORT=5436
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=agronexus
DB_LOGGING=false

# --- Tokens ---
# Generate each with: openssl rand -hex 32
# They MUST differ: a shared key would let a stolen access token mint refreshes.
# Each must be at least 32 characters or the service refuses to boot.
JWT_SECRET=replace-me-with-64-hex-characters-of-randomness-0000000000000000
JWT_REFRESH_SECRET=replace-me-with-a-different-64-hex-random-string-111111111
JWT_REFRESH_TTL_DAYS=7

# --- Frontend ---
# Used to build the verification and password-reset links sent by email.
FRONTEND_BASE_URL=http://localhost:3000

# --- Internal service token ---
# Signs the short-lived token backend presents to ai-service as
# X-Internal-Service-Token on server-side calls. Generate with:
#   openssl rand -hex 32
# MUST differ from both JWT_SECRET and JWT_REFRESH_SECRET: a shared key would
# let a user's access token be replayed as a service credential. The service
# refuses to boot if they collide.
# ai-service verifies it with its own INTERNAL_SERVICE_SECRET — set the SAME
# value in ai-service/.env. If either side is unset, ai-service rejects every
# proxied call (it fails closed) rather than accepting an unauthenticated one.
INTERNAL_SERVICE_SECRET=replace-me-with-a-third-64-hex-random-string-22222222

# --- AI service ---
# Where backend reaches ai-service. Under Docker Compose use the service name;
# from a host-run Nest process, localhost. The browser never uses this.
AI_SERVICE_URL=http://localhost:8000

# --- Service ---
PORT=4000
NODE_ENV=development
